<output> ::=
  <receivers-count>
[ <mc-receiver> ... ]
  <mc-shadow>
  <mc-missing>
[ <receiver-hit> ... ]

<receivers-count> ::=
  INTEGER

<mc-receiver> ::=
  <receiver-name> <receiver-id> <estimation>

<receiver-id> ::=
  INTEGER

<receiver-name> ::=
  STRING

<mc-shadow> ::=
  <estimation>

<mc-missing> ::=
  <estimation>

<estimation> ::=
  REAL REAL # Expected value and standard error

<receiver-hit> ::= TODO
